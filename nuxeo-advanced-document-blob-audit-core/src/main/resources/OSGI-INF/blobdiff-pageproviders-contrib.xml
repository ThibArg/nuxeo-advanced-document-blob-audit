<?xml version="1.0"?>
<component name="org.nuxeo.audit.advanced.blob.pageproviders">

  <extension target="org.nuxeo.ecm.platform.query.api.PageProviderService" point="providers">

    <!-- Rebuilds the "list of diffs for this document" view without storing anything on it -->
    <coreQueryPageProvider name="BLOB_DIFFS_FOR_DOCUMENT">
      <pattern>
        SELECT * FROM BlobDiff WHERE bdiff:sourceId = ? AND ecm:isTrashed = 0
        ORDER BY bdiff:date DESC
      </pattern>
      <parameter>0</parameter>
      <pageSize>20</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>

    <!--
      Search-engine backed page provider behind the Web UI "Content changes audit" page and the
      source document tab.

      SearchServicePageProvider lives in nuxeo-platform-query-api, not in the Elasticsearch bundle,
      so this component always registers: there is no missing class to guard against and a
      <require> on ElasticSearchComponent would be both useless and harmful - it would keep the
      whole component, BLOB_DIFFS_FOR_DOCUMENT included, pending on any instance without a search
      engine, and in the unit tests.

      What does need a search engine is the *execution*: the provider resolves SearchService at
      query time and throws if none is configured. That is acceptable here, a real instance always
      has one, but it is a query-time failure, not a registration-time one.
    -->
    <genericPageProvider name="BLOB_DIFFS_ADMIN"
                         class="org.nuxeo.ecm.platform.query.nxql.SearchServicePageProvider">
      <trackUsage>false</trackUsage>
      <property name="coreSession">#{documentManager}</property>
      <!--
        searchDocumentType, NOT whereClause@docType: WhereClauseDescriptor declares only @escaper,
        predicate and fixedPart, so XMap drops any docType attribute in silence. Without this
        element PageProviderHelper falls back to SimpleDocumentModel.empty(), and because the
        predicates below carry a schema, NXQLQueryBuilder#getRawValue reads null from it *without
        throwing* - so the named-parameters fallback never runs and every filter is dropped
        quietly. That fallback model happens to work for the bdsearch: prefixed keys the Web UI
        sends, because it is built with anySchema=true and resolves a prefix through the schema
        registry; it would not work for bare field names. Declaring the real search doctype makes
        both forms valid and removes the trap.
      -->
      <searchDocumentType>BlobDiffSearch</searchDocumentType>
      <whereClause>
        <fixedPart>
          ecm:primaryType = 'BlobDiff' AND ecm:isVersion = 0 AND ecm:isTrashed = 0
        </fixedPart>
        <predicate parameter="bdiff:sourceId" operator="=">
          <field schema="blobdiffsearch" name="sourceId" />
        </predicate>
        <predicate parameter="bdiff:user" operator="=">
          <field schema="blobdiffsearch" name="user" />
        </predicate>
        <predicate parameter="bdiff:date" operator="BETWEEN">
          <field schema="blobdiffsearch" name="date_min" />
          <field schema="blobdiffsearch" name="date_max" />
        </predicate>
        <predicate parameter="bdiff:truncated" operator="=">
          <field schema="blobdiffsearch" name="truncated" />
        </predicate>
      </whereClause>
      <!--
        Three distinct names per aggregate, do not conflate them:
          @id         key of the bucket list in the JSON response, read by the search form as
                      aggregations.bdiff_<x>_agg;
          @parameter  the indexed field actually aggregated on;
          field/@name where the *selection* is read back from the search document, so the key the
                      client sends to filter on it - bdsearch:<x>_agg here.
        Keeping @id different from field/@name is harmless on the /execute path used by the UI,
        but note it would break a /search/pp/{name}/bulk submission, which keys selections on @id.
        The field must stay an nxs:stringList, and its value is sent as a JSON array.
      -->
      <aggregates>
        <aggregate id="bdiff_status_agg" type="terms" parameter="bdiff:status">
          <field schema="blobdiffsearch" name="status_agg" />
          <properties>
            <property name="size">10</property>
          </properties>
        </aggregate>
        <aggregate id="bdiff_mimetype_agg" type="terms" parameter="bdiff:mimeType">
          <field schema="blobdiffsearch" name="mimetype_agg" />
          <properties>
            <property name="size">20</property>
          </properties>
        </aggregate>
        <aggregate id="bdiff_xpath_agg" type="terms" parameter="bdiff:xpath">
          <field schema="blobdiffsearch" name="xpath_agg" />
          <properties>
            <property name="size">20</property>
          </properties>
        </aggregate>
        <aggregate id="bdiff_user_agg" type="terms" parameter="bdiff:user">
          <field schema="blobdiffsearch" name="user_agg" />
          <properties>
            <property name="size">20</property>
          </properties>
        </aggregate>
      </aggregates>
      <sort column="bdiff:date" ascending="false" />
      <pageSize>40</pageSize>
      <maxPageSize>200</maxPageSize>
    </genericPageProvider>

  </extension>

</component>
