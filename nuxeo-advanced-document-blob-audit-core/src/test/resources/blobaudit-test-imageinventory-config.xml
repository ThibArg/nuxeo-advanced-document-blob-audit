<?xml version="1.0"?>
<component name="org.nuxeo.audit.advanced.blob.test.imageinventory">

  <require>org.nuxeo.audit.advanced.blob.test.config</require>

  <!-- Turns the image inventory on, to exercise the imageExtractors extension point. -->
  <extension target="org.nuxeo.audit.advanced.blob.BlobDiffComponent" point="config">
    <config enabled="true">
      <maxBlobSize>1048576</maxBlobSize>
      <maxLines>1000</maxLines>
      <maxDiffEntries>500</maxDiffEntries>
      <imageInventory>true</imageInventory>
      <docTypes />
      <xpaths>
        <xpath>file:content</xpath>
      </xpaths>
    </config>
  </extension>

</component>
