<?xml version="1.0"?>
<component name="org.nuxeo.audit.advanced.blob.doctype">

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="schema">
    <schema name="blobdiff" prefix="bdiff" src="schemas/blobdiff.xsd" />
    <schema name="blobdiffsearch" prefix="bdsearch" src="schemas/blobdiffsearch.xsd" />
  </extension>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
    <doctype name="BlobDiff" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <schema name="blobdiff" />
      <!-- Never surfaced in navigation or collections -->
      <facet name="HiddenInNavigation" />
      <facet name="NotCollectionMember" />
      <!--
        Critical. bdiff:diff is a blob holding business content extracted from the source document.
        Without this facet the platform runs its binary text extraction on it and copies that
        content into the fulltext index (and therefore into Elasticsearch), which both defeats the
        confidentiality of the restricted /change-diff container and doubles the conversion cost of
        every diff. See FulltextConfigurationFactory and FacetNames.NOT_FULLTEXT_INDEXABLE.
      -->
      <facet name="NotFulltextIndexable" />
    </doctype>
    <!-- Search document of BLOB_DIFFS_ADMIN, never persisted -->
    <doctype name="BlobDiffSearch" extends="Document">
      <schema name="blobdiffsearch" />
      <facet name="HiddenInNavigation" />
    </doctype>
  </extension>

</component>
