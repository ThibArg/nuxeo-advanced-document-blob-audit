<?xml version="1.0"?>
<component name="org.nuxeo.audit.advanced.blob.test.dynamicfacet">

  <!-- API-03: a blob in a schema brought by a facet added to the document, not by its type. -->
  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="schema">
    <schema name="blobauditextra" prefix="bdextra" src="schemas/blobaudit-test-extra.xsd" />
  </extension>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
    <facet name="BlobAuditExtra">
      <schema name="blobauditextra" />
    </facet>
  </extension>

</component>
