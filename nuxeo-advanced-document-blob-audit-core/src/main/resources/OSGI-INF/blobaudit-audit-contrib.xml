<?xml version="1.0"?>
<component name="org.nuxeo.audit.advanced.blob.audit">

  <require>org.nuxeo.audit.service.AuditComponent.defaultContrib</require>

  <extension target="org.nuxeo.audit.service.AuditComponent" point="routes">
    <documentation>
      Declaring the event in a route registers it as auditable: BlobModificationListener fires
      blobContentModified and the platform pipeline (AuditRouter, audit/audit stream) writes the
      entry. Without this route the event is simply not audited.
      Keep this in sync with BlobAuditConstants.EVENT_BLOB_MODIFIED.
    </documentation>
    <route name="advanced-document-blob-audit">
      <backend name="default" />
      <event name="blobContentModified" />
    </route>
  </extension>

  <extension target="org.nuxeo.audit.service.AuditComponent" point="extendedInfo">
    <documentation>
      Maps the event context properties set by BlobModificationListener#buildAuditEvent to the
      extended infos of the log entry. Keys must match BlobAuditConstants.EXT_*.
    </documentation>
    <extendedInfo event="blobContentModified" key="xpath" expression="${message.properties.xpath}" />
    <extendedInfo event="blobContentModified" key="oldFilename" expression="${message.properties.oldFilename}" />
    <extendedInfo event="blobContentModified" key="newFilename" expression="${message.properties.newFilename}" />
    <extendedInfo event="blobContentModified" key="diffCorrelationId"
      expression="${message.properties.diffCorrelationId}" />
    <!-- Set only when the binary changed but could not be diffed (too large, unsupported format).
         Mutually exclusive with diffCorrelationId; absent on the nominal path. -->
    <extendedInfo event="blobContentModified" key="skipReason" expression="${message.properties.skipReason}" />
  </extension>

</component>
