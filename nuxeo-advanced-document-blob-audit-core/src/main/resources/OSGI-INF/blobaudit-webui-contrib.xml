<?xml version="1.0"?>
<!-- Registers the Web UI bundle of the plugin. Pending (harmless) where Web UI is not deployed. -->
<component name="org.nuxeo.audit.advanced.blob.webui">

  <require>org.nuxeo.web.ui.resources</require>

  <extension target="org.nuxeo.ecm.platform.WebResources" point="resources">
    <resource name="nuxeo-advanced-document-blob-audit.html" type="import" shrinkable="false">
      <uri>/ui/nuxeo-advanced-document-blob-audit/nuxeo-advanced-document-blob-audit.html</uri>
    </resource>
  </extension>

  <extension target="org.nuxeo.ecm.platform.WebResources" point="bundles">
    <bundle name="web-ui">
      <resources append="true">
        <resource>nuxeo-advanced-document-blob-audit.html</resource>
      </resources>
    </bundle>
  </extension>

</component>
