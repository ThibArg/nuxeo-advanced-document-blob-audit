<?xml version="1.0"?>
<!--
  Search document of the BLOB_DIFFS_ADMIN page provider. Never persisted: Web UI sends the named
  parameters (bdsearch:*) and the page provider maps them onto its predicates and aggregates.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:nxs="http://www.nuxeo.org/ecm/schemas/blobdiffsearch/"
           targetNamespace="http://www.nuxeo.org/ecm/schemas/blobdiffsearch/">

  <xs:simpleType name="stringList">
    <xs:list itemType="xs:string" />
  </xs:simpleType>

  <!-- Predicates -->
  <xs:element name="sourceId" type="xs:string" />
  <xs:element name="user" type="xs:string" />
  <xs:element name="date_min" type="xs:date" />
  <xs:element name="date_max" type="xs:date" />
  <xs:element name="truncated" type="xs:boolean" />

  <!-- Aggregate selections -->
  <xs:element name="status_agg" type="nxs:stringList" />
  <xs:element name="mimetype_agg" type="nxs:stringList" />
  <xs:element name="xpath_agg" type="nxs:stringList" />
  <xs:element name="user_agg" type="nxs:stringList" />

</xs:schema>
