<?xml version="1.0"?>
<component name="org.nuxeo.audit.advanced.blob.listener">

  <require>org.nuxeo.audit.advanced.blob.BlobDiffComponent</require>

  <extension target="org.nuxeo.ecm.core.event.EventServiceComponent" point="listener">
    <documentation>
      Synchronous listener on documentModified (before update), scoped to blob properties only.
      It compares digests and schedules the expensive work; it never extracts anything itself.
    </documentation>
    <listener name="blobModificationListener" async="false" postCommit="false"
              class="org.nuxeo.audit.advanced.blob.BlobModificationListener" priority="130">
      <event>beforeDocumentModification</event>
    </listener>
  </extension>

</component>
